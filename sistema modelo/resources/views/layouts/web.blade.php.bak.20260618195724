<script>
    // Alpine store for the cart using localStorage
    document.addEventListener('alpine:init', () => {
        Alpine.store('cart', {
            items: JSON.parse(localStorage.getItem('sw_cart') || '[]'),
            add(product, qty = 1, type = 'retail') {
                const existing = this.items.find(i => i.id === product.id && i.type === type);
                if (existing) existing.qty += Number(qty);
                else this.items.push({ id: product.id, name: product.nombre, price: product.precio_detal, qty: Number(qty), type });
                this.save();
            },
            remove(index) {
                this.items.splice(index, 1);
                this.save();
            },
            total() {
                return this.items.reduce((s, i) => s + (i.price * i.qty), 0).toFixed(2);
            },
            count() {
                return this.items.reduce((s, i) => s + i.qty, 0);
            },
            save() { localStorage.setItem('sw_cart', JSON.stringify(this.items)); }
        });
    });
</script>


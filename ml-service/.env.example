# Conexión de solo lectura (database/sql/usuario_ml.sql)
ML_DB_HOST=127.0.0.1
ML_DB_PORT=3306
ML_DB_DATABASE=smartphoneworld
ML_DB_USERNAME=sw_ml
ML_DB_PASSWORD=

# Clave compartida con Laravel (ML_API_KEY en el .env de Laravel). Solo caracteres ASCII.
ML_API_KEY=

# Segundos que se reutiliza un reporte calculado y semanas de historial que se leen
ML_CACHE_TTL=3600
ML_SEMANAS_HISTORIAL=52
